#!/usr/bin/python3
import argparse
import hashlib
import http.client
import json
import os
from pathlib import Path
import select
import socket
import struct
import subprocess
import sys
import threading
import time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from urllib.parse import urlsplit


MAX_BODY_BYTES = 32 * 1024 * 1024
BODY_TIMEOUT = 15
IDENTITY_PATH = "/_strata-router"
UPSTREAM_URL = "https://api.anthropic.com"
HOP_HEADERS = {
    "connection", "keep-alive", "te", "trailer", "transfer-encoding",
    "upgrade", "expect",
}


def source_digest():
    return hashlib.sha256(Path(__file__).read_bytes()).hexdigest()


def identity(model, engine_url, upstream_url):
    return {"source_sha256": source_digest(), "model": model,
            "engine_url": engine_url, "upstream_url": upstream_url}


def end_to_end_headers(headers):
    excluded = set(HOP_HEADERS)
    for value in headers.get_all("Connection", []):
        excluded.update(part.strip().lower() for part in value.split(","))
    return [(name, value) for name, value in headers.items()
            if name.lower() not in excluded and not name.lower().startswith("proxy-")]


def target_connection(url, timeout):
    target = urlsplit(url)
    connection_type = (http.client.HTTPSConnection if target.scheme == "https"
                       else http.client.HTTPConnection)
    return connection_type(target.hostname, target.port, timeout=timeout), target.netloc


class RouterServer(ThreadingHTTPServer):
    def __init__(self, address, model, engine_url, upstream_url, log):
        self.identity = identity(model, engine_url, upstream_url)
        self.log = log
        self.log_lock = threading.Lock()
        super().__init__(address, RouterHandler)

    def handle_error(self, request, client_address):
        # Exceptions can contain credentials or request content.
        pass

    def record(self, record):
        with self.log_lock:
            print(json.dumps(record, ensure_ascii=True), file=self.log, flush=True)


class RouterHandler(BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"

    def setup(self):
        super().setup()
        self.connection.settimeout(BODY_TIMEOUT)

    def log_message(self, *args):
        pass

    def send_error(self, code, message=None, explain=None):
        self.error_response(code, "invalid request")

    def error_response(self, status, message):
        body = json.dumps({"type": "error", "error": {
            "type": "api_error", "message": "strata-router: " + message,
        }}).encode()
        self.send_response_only(status)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Connection", "close")
        self.end_headers()
        self.close_connection = True
        if self.command != "HEAD":
            self.wfile.write(body)
            self.wfile.flush()

    def request_body(self):
        if self.headers.get_all("Transfer-Encoding"):
            return None, 411, "Transfer-Encoding is unsupported"
        lengths = self.headers.get_all("Content-Length", [])
        if not lengths and self.command in {"GET", "HEAD", "OPTIONS", "DELETE"}:
            return b"", None, None
        if not lengths:
            return None, 411, "Content-Length is required"
        if len(lengths) != 1 or not lengths[0].isascii() or not lengths[0].isdigit():
            return None, 400, "invalid Content-Length"
        length = int(lengths[0])
        if length > MAX_BODY_BYTES:
            return None, 413, "request body is too large"
        deadline = time.monotonic() + BODY_TIMEOUT
        body = bytearray()
        while len(body) < length:
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                return None, 408, "request body timed out"
            self.connection.settimeout(remaining)
            try:
                piece = self.rfile.read1(min(65536, length - len(body)))
            except socket.timeout:
                return None, 408, "request body timed out"
            if not piece:
                return None, 400, "incomplete request body"
            body.extend(piece)
        self.connection.settimeout(BODY_TIMEOUT)
        return bytes(body), None, None

    def watch_client(self, target_socket, done, disconnected):
        while not done.wait(0.5):
            try:
                readable, _, _ = select.select([self.connection], [], [], 0)
                gone = bool(readable) and self.connection.recv(1, socket.MSG_PEEK) == b""
            except ConnectionError:
                gone = True
            except OSError:
                return
            if gone and not done.is_set():
                disconnected.set()
                try:
                    # SSLSocket.shutdown() clears TLS state, so a racing send from the request thread would go out as plaintext.
                    socket.socket.shutdown(target_socket, socket.SHUT_RDWR)
                except OSError:
                    pass
                return

    def proxy(self):
        started = time.monotonic()
        model = None
        route = "router"
        status = None
        outcome = "complete"
        target = None
        headers_sent = False
        response = None
        watch_done = threading.Event()
        client_disconnected = threading.Event()
        watcher = None
        self.close_connection = True
        try:
            body, error_status, message = self.request_body()
            if error_status:
                status = error_status
                self.error_response(status, message)
                return
            if self.command == "GET" and self.path == IDENTITY_PATH:
                payload = json.dumps(self.server.identity).encode()
                status = 200
                self.send_response_only(status)
                self.send_header("Content-Type", "application/json")
                self.send_header("Content-Length", str(len(payload)))
                self.send_header("Connection", "close")
                self.end_headers()
                self.wfile.write(payload)
                return
            if self.command == "POST":
                try:
                    data = json.loads(body)
                    if isinstance(data, dict) and isinstance(data.get("model"), str):
                        model = data["model"]
                except (ValueError, UnicodeError, RecursionError):
                    pass
            route = "engine" if model == self.server.identity["model"] else "upstream"
            url = (self.server.identity["engine_url"] if route == "engine"
                   else self.server.identity["upstream_url"])
            target, host = target_connection(url, timeout=600)
            target.connect()
            # Pass target.sock now: getresponse() detaches it from target for a Connection: close response.
            watcher = threading.Thread(target=self.watch_client,
                                       args=(target.sock, watch_done, client_disconnected),
                                       daemon=True, name="strata-router-client-watch")
            watcher.start()
            target.putrequest(self.command, self.path, skip_host=True, skip_accept_encoding=True)
            target.putheader("Host", host)
            for name, value in end_to_end_headers(self.headers):
                if name.lower() == "host":
                    continue
                if route == "engine" and name.lower() in {"authorization", "x-api-key"}:
                    continue
                target.putheader(name, value)
            target.endheaders(body)
            response = target.getresponse()
            status = response.status
            response_headers = end_to_end_headers(response.headers)
            no_body = self.command == "HEAD" or status in {204, 304}
            self.send_response_only(status, response.reason)
            for name, value in response_headers:
                if name.lower() == "content-length":
                    # http.client removes chunk framing, so its byte count owns framing.
                    if response.chunked or status == 204:
                        continue
                    if not no_body and (response.length is None or int(value) != response.length):
                        continue
                self.send_header(name, value)
            self.send_header("Connection", "close")
            try:
                self.end_headers()
            except OSError:
                client_disconnected.set()
                return
            headers_sent = True
            if not no_body:
                while True:
                    piece = response.read1(65536)
                    if not piece:
                        if response.length:
                            outcome = "truncated"
                        break
                    try:
                        self.wfile.write(piece)
                        self.wfile.flush()
                    except OSError:
                        client_disconnected.set()
                        return
        except (OSError, http.client.HTTPException, ValueError):
            outcome = ("truncated" if response is not None and (response.length or response.chunked)
                       else "transport-error")
            if not headers_sent and not client_disconnected.is_set():
                status = 502
                message = ("cannot reach engine at " + self.server.identity["engine_url"] + " (start it first)"
                           if route == "engine" else
                           "cannot reach " + urlsplit(self.server.identity["upstream_url"]).netloc)
                self.error_response(status, message)
        finally:
            watch_done.set()
            if watcher is not None:
                watcher.join()
            if client_disconnected.is_set():
                outcome = "client-disconnected"
            if headers_sent and outcome != "complete":
                try:
                    self.connection.setsockopt(socket.SOL_SOCKET, socket.SO_LINGER, struct.pack("ii", 1, 0))
                except OSError:
                    pass
                # socketserver's shutdown can send FIN before the abortive close.
                self.connection.close()
            if response is not None:
                response.close()
            if target is not None:
                target.close()
            self.server.record({"method": self.command, "path": self.path, "model": model,
                                "route": route, "status": status, "outcome": outcome,
                                "duration": round(time.monotonic() - started, 3)})

    def __getattr__(self, name):
        if name.startswith("do_"):
            return self.proxy
        raise AttributeError(name)


def port_open(port):
    try:
        with socket.create_connection(("127.0.0.1", port), timeout=0.2):
            return True
    except OSError:
        return False


def matches_listener(port, expected):
    connection = http.client.HTTPConnection("127.0.0.1", port, timeout=1)
    try:
        connection.request("GET", IDENTITY_PATH)
        response = connection.getresponse()
        return response.status == 200 and json.loads(response.read(4096)) == expected
    except (OSError, ValueError, http.client.HTTPException):
        return False
    finally:
        connection.close()


def listener_error(port):
    try:
        result = subprocess.run(["/usr/sbin/lsof", "-nP", "-t", "-iTCP:" + str(port),
                                 "-sTCP:LISTEN"], capture_output=True, text=True, timeout=3)
        pids = " ".join(dict.fromkeys(result.stdout.split())) or "unknown"
    except (OSError, subprocess.TimeoutExpired):
        pids = "unknown"
    print("strata-router: listener on port {} does not match (PID {}). "
          "Stop it with `kill <PID>` after checking the owner, then retry.".format(port, pids),
          file=sys.stderr)


def ensure_router(args):
    expected = identity(args.model, args.engine_url, args.test_upstream_url or UPSTREAM_URL)
    if not port_open(args.port):
        command = [sys.executable, str(Path(__file__).resolve()), "--port", str(args.port),
                   "--model", args.model, "--engine-url", args.engine_url,
                   "--log-file", args.log_file]
        if args.test_upstream_url:
            command.extend(["--test-upstream-url", args.test_upstream_url])
        try:
            child = subprocess.Popen(command, stdin=subprocess.DEVNULL,
                                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except OSError:
            print("strata-router: cannot start router. Check " + args.log_file, file=sys.stderr)
            return 1
        deadline = time.monotonic() + 5
        while not port_open(args.port):
            if child.poll() is not None or time.monotonic() >= deadline:
                if port_open(args.port):
                    break
                print("strata-router: startup failed. Check " + args.log_file, file=sys.stderr)
                return 1
            time.sleep(0.05)
    if not matches_listener(args.port, expected):
        listener_error(args.port)
        return 1
    return 0


def origin(value):
    try:
        parsed = urlsplit(value)
        valid = (parsed.scheme in {"http", "https"} and parsed.hostname and
                 parsed.path in {"", "/"} and not parsed.query and not parsed.fragment and
                 parsed.username is None and parsed.password is None)
        parsed.port
    except ValueError:
        valid = False
    if not valid:
        raise argparse.ArgumentTypeError("expected an HTTP(S) origin without credentials")
    return value


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--port", type=int, required=True)
    parser.add_argument("--model", required=True)
    parser.add_argument("--engine-url", type=origin, required=True)
    parser.add_argument("--log-file", required=True)
    parser.add_argument("--ensure", action="store_true")
    parser.add_argument("--test-upstream-url", type=origin,
                        help="tests only: override upstream with a loopback HTTP server")
    args = parser.parse_args()
    if not 1 <= args.port <= 65535:
        parser.error("port must be between 1 and 65535")
    if args.test_upstream_url:
        upstream = urlsplit(args.test_upstream_url)
        if upstream.scheme != "http" or upstream.hostname not in {"127.0.0.1", "localhost", "::1"}:
            parser.error("test upstream must be a loopback HTTP origin")
    if args.ensure:
        return ensure_router(args)
    try:
        os.setsid()
        log_path = Path(args.log_file).expanduser()
        log_path.parent.mkdir(parents=True, exist_ok=True)
        log_fd = os.open(str(log_path), os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600)
        null_fd = os.open(os.devnull, os.O_RDONLY)
        os.dup2(null_fd, 0)
        os.dup2(log_fd, 1)
        os.dup2(log_fd, 2)
        os.close(null_fd)
        os.close(log_fd)
        with RouterServer(("127.0.0.1", args.port), args.model, args.engine_url,
                          args.test_upstream_url or UPSTREAM_URL, sys.stderr) as server:
            server.serve_forever()
    except OSError:
        print("strata-router: startup failed (cannot detach, open log, or bind listener)",
              file=sys.stderr, flush=True)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
