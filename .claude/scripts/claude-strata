#!/bin/sh
# Keep the main model on Strata and send other models upstream to preserve its prompt cache.
# The Anthropic env is exported ONLY for this process, so your normal `claude` is untouched.
# Start the model first:  ~/projects/Strata/run-iq3_s.sh   (serves on 127.0.0.1:8099)
# On PATH: ln -s ~/.claude/scripts/claude-strata ~/.local/bin/
model=strata-local
router_port=8098
engine_url=http://127.0.0.1:8099

# Resolve the installed symlink so worktree launches use the same worktree's router.
script=$(realpath "$0") || exit 1
script_dir=$(dirname "$script")
/usr/bin/python3 "$script_dir/strata-router" --ensure \
    --port "$router_port" --model "$model" --engine-url "$engine_url" \
    --log-file "$HOME/Library/Logs/strata-router.log" || exit 1

# Nested launches must use the subscription login instead of inherited local credentials.
unset ANTHROPIC_AUTH_TOKEN ANTHROPIC_API_KEY ANTHROPIC_SMALL_FAST_MODEL
unset ANTHROPIC_DEFAULT_HAIKU_MODEL ANTHROPIC_DEFAULT_SONNET_MODEL ANTHROPIC_DEFAULT_OPUS_MODEL
export ANTHROPIC_BASE_URL="http://127.0.0.1:$router_port"
export ANTHROPIC_MODEL="$model"
export CLAUDE_CODE_SUBAGENT_MODEL=opus
export CLAUDE_CODE_SUBAGENT_MODEL_FORCE=1
export CLAUDE_CODE_FORK_SUBAGENT=0
export CLAUDE_CODE_ENABLE_PROMPT_SUGGESTION=0
# The engine holds 262,144 KV cells: a 200K window plus Claude Code's 32K output default fits.
export CLAUDE_CODE_MAX_CONTEXT_TOKENS=200000
export CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC="1"
# Skip permission prompts by default (requested). strata-main-guard still denies main-thread edits.
# A passed flag still overrides the permission mode since it comes after.
# The appended prompt reaches the main session only: subagents build their own system prompt.
exec claude --dangerously-skip-permissions \
    --settings "$(/usr/bin/python3 "$script_dir/strata-main-guard" --settings)" \
    --append-system-prompt-file "$script_dir/claude-strata.prompt.md" "$@"
