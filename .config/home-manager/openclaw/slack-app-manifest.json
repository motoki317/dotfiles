{
  "display_information": {
    "name": "Catmarius",
    "description": "@toki personal OpenClaw assistant"
  },
  "features": {
    "bot_user": {
      "display_name": "Catmarius",
      "always_online": true
    },
    "app_home": {
      "home_tab_enabled": false,
      "messages_tab_enabled": true,
      "messages_tab_read_only_enabled": false
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "app_mentions:read",
        "channels:history",
        "channels:read",
        "groups:history",
        "groups:read",
        "chat:write",
        "files:read",
        "users:read",
        "usergroups:read",
        "im:history",
        "im:read",
        "im:write"
      ]
    }
  },
  "settings": {
    "socket_mode_enabled": true,
    "event_subscriptions": {
      "bot_events": [
        "app_mention",
        "message.channels",
        "message.groups",
        "message.im"
      ]
    }
  }
}
